#!/usr/bin/env bash
set -euo pipefail

# Updates direct dependencies in package.json to their latest version (including
# major bumps) and refreshes the lockfile: pnpm-lock.yaml when the repo has one,
# yarn.lock otherwise. Run from the repo root.
#
# Major bumps will occasionally break the build -- that's expected and
# fixed as it comes up, rather than letting deps drift indefinitely.
#
# Packages that stay on a given major or minor, or are skipped, are configured in
# the repo's .ncurc.js (npm-check-updates picks it up from the working directory).
#
# Env vars:
#   PACKAGES   - optional comma-separated npm-check-updates --filter globs.
#                When set, only matching packages are updated (used for
#                scoped/curated update PRs). When unset, all direct
#                dependencies are updated (the normal weekly run).
#   WORKSPACES - "true" to also update the root and every workspace package.json
#   COOLDOWN   - minimum age of a version to adopt, as npm-check-updates --cooldown takes it
#                (default 7d, 0 disables)
#   NCU_VERSION - npm-check-updates version to run (default: newest release past COOLDOWN)

PACKAGES="${PACKAGES:-}"
WORKSPACES="${WORKSPACES:-false}"
COOLDOWN="${COOLDOWN:-7d}"

ARGS=(-u)

# Supply chain safety: skip versions published within the cooldown window.
if [[ "$COOLDOWN" != "0" ]]; then
  ARGS+=(--cooldown "$COOLDOWN")
fi

PACKAGE_MANAGER=yarn
if [[ -f pnpm-lock.yaml ]]; then
  PACKAGE_MANAGER=pnpm
  # Lets npm-check-updates find the workspaces in pnpm-workspace.yaml.
  ARGS+=(--packageManager pnpm)
fi

if [[ "$WORKSPACES" == "true" ]]; then
  ARGS+=(--root --workspaces)
fi

if [[ -n "$PACKAGES" ]]; then
  echo "Updating selected dependencies: $PACKAGES"
  ARGS+=(--filter "$PACKAGES")
else
  echo "Updating direct dependencies..."
fi

# Run an exact version, the newest one past the cooldown, so a hijacked npm-check-updates
# release does not run with this job's token the day it is published.
NCU_VERSION="${NCU_VERSION:-$(COOLDOWN="$COOLDOWN" bash "$(dirname "${BASH_SOURCE[0]}")/resolve-ncu-version")}"
echo "Using npm-check-updates $NCU_VERSION"
npx --yes "npm-check-updates@${NCU_VERSION}" "${ARGS[@]}"

node "$(dirname "${BASH_SOURCE[0]}")/sync-resolutions"

echo "Running $PACKAGE_MANAGER install..."
if [[ "$PACKAGE_MANAGER" == "pnpm" ]]; then
  # pnpm freezes the lockfile by default in CI; here refreshing it is the point.
  pnpm install --no-frozen-lockfile
else
  yarn install
fi

echo "Done."
