#!/usr/bin/env bash
set -euo pipefail

# Creates or updates a PR with the changes an update action left in the working tree.
# Idempotent: if a PR already exists on the update branch, it refreshes the body
# and force-pushes the branch instead of opening a duplicate.
#
# Environment variables:
#   GH_TOKEN           - GitHub token with repo + PR write access (required in CI)
#   PR_FILES           - whitespace separated pathspecs that may hold changes, globs allowed (required)
#   PR_DIFF_EXCLUDE    - pathspecs left out of the PR body diff, e.g. lockfiles (default: none)
#   PR_BRANCH          - branch name for the update (default: chore/update-dependencies)
#   PR_TITLE           - PR title (default: "chore(deps): weekly dependency update")
#   PR_COMMIT_MESSAGE  - commit message (default: PR_TITLE)
#   PR_BODY_HEADING    - PR body heading (default: "Dependency updates")
#   PR_BODY_INTRO      - markdown shown above the diff (default: none)
#   PR_LABELS          - comma-separated labels (default: "dependencies")
#   BASE_BRANCH        - PR target branch (default: main)

PR_BRANCH="${PR_BRANCH:-chore/update-dependencies}"
PR_TITLE="${PR_TITLE:-chore(deps): weekly dependency update}"
PR_COMMIT_MESSAGE="${PR_COMMIT_MESSAGE:-$PR_TITLE}"
PR_BODY_HEADING="${PR_BODY_HEADING:-Dependency updates}"
PR_BODY_INTRO="${PR_BODY_INTRO:-}"
PR_LABELS="${PR_LABELS:-dependencies}"
BASE_BRANCH="${BASE_BRANCH:-main}"

read -r -d '' -a FILE_SPECS <<< "${PR_FILES:?PR_FILES is required}" || true
read -r -d '' -a EXCLUDES <<< "${PR_DIFF_EXCLUDE:-}" || true

# Files that changed among the pathspecs. Unlike git add, ls-files does not fail
# on a pathspec that matches nothing (e.g. packages/*/package.json without workspaces).
mapfile -d '' -t CHANGED < <(git ls-files -z --modified --others --exclude-standard -- "${FILE_SPECS[@]}")

# No-op if nothing changed
if [[ ${#CHANGED[@]} -eq 0 ]]; then
  echo "No changes to ${FILE_SPECS[*]} — nothing to do."
  [[ -n "${GITHUB_OUTPUT:-}" ]] && echo "updated=false" >> "$GITHUB_OUTPUT"
  exit 0
fi

# Ensure git identity is set (required for commits; no-op if already configured)
git config user.email "github-actions[bot]@users.noreply.github.com" 2>/dev/null || true
git config user.name "github-actions[bot]" 2>/dev/null || true

# Create/reset the update branch off the current HEAD (which is main in CI)
git checkout -B "$PR_BRANCH"
git add -- "${CHANGED[@]}"
# --no-verify: pre-commit hooks may run tooling the update just bumped (husky, lint-staged,
# eslint), so a major bump can break the hook before CI gets a chance to lint the PR.
git commit --no-verify -m "$PR_COMMIT_MESSAGE"
git push origin "$PR_BRANCH" --force-with-lease

# Build a PR body showing the diff of the changed files
DIFF_SPECS=("${CHANGED[@]}")
for exclude in "${EXCLUDES[@]}"; do
  DIFF_SPECS+=(":(exclude)$exclude")
done
DIFF=$(git diff "origin/${BASE_BRANCH}" -- "${DIFF_SPECS[@]}" 2>/dev/null || git diff HEAD~1 -- "${DIFF_SPECS[@]}")
INTRO="${PR_BODY_INTRO:+$PR_BODY_INTRO

}"
BODY="## ${PR_BODY_HEADING}

${INTRO}\`\`\`diff
${DIFF}
\`\`\`

---
*Automated update via the \`${GITHUB_WORKFLOW:-update-dependencies}\` workflow.*"

OWNER_REPO=$(git remote get-url origin | sed -E 's|.*github\.com[:/]||; s|\.git$||')
OWNER="${OWNER_REPO%%/*}"

EXISTING=$(gh api "repos/${OWNER_REPO}/pulls?head=${OWNER}:${PR_BRANCH}&state=open" \
  --jq '.[0].html_url // ""' 2>/dev/null) || EXISTING=""

if [[ -n "$EXISTING" ]]; then
  echo "Updating existing PR: $EXISTING"
  PR_NUMBER=$(basename "$EXISTING")
  gh api "repos/${OWNER_REPO}/pulls/${PR_NUMBER}" --method PATCH --field body="$BODY" > /dev/null
  PR_URL="$EXISTING"
else
  echo "Creating new PR..."
  PR_RESPONSE=$(gh api "repos/${OWNER_REPO}/pulls" \
    --method POST \
    --field title="$PR_TITLE" \
    --field body="$BODY" \
    --field head="$PR_BRANCH" \
    --field base="$BASE_BRANCH")
  PR_URL=$(echo "$PR_RESPONSE" | jq -r '.html_url')
  PR_NUMBER=$(echo "$PR_RESPONSE" | jq -r '.number')
  # Add labels (PRs are issues in the GitHub REST API)
  jq -nc --arg labels "$PR_LABELS" '{"labels": ($labels | split(","))}' | \
    gh api "repos/${OWNER_REPO}/issues/${PR_NUMBER}/labels" --method POST --input - > /dev/null || true
fi

echo "PR: $PR_URL"

if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
  echo "updated=true"    >> "$GITHUB_OUTPUT"
  echo "pr-url=$PR_URL"  >> "$GITHUB_OUTPUT"
fi
